# User-level systemd unit for the open-atc speech gateway.
# Install on the services host (no root needed):
#   mkdir -p ~/.config/systemd/user
#   cp scripts/atc-speech-gateway.service ~/.config/systemd/user/
#   cp scripts/speech_gateway.py ~/atc_test/
#   systemctl --user daemon-reload
#   systemctl --user enable --now atc-speech-gateway
#   loginctl enable-linger $USER   # keep it running after logout
# Requires: ~/.venvs/atc venv (see speech-gateway-requirements.txt),
# kokoro-v1.0.onnx + voices-v1.0.bin in ~/atc_test.
[Unit]
Description=OpenATC speech gateway (kokoro TTS + faster-whisper STT)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/atc_test
Environment=ONNX_PROVIDER=CUDAExecutionProvider
Environment=LD_LIBRARY_PATH=%h/.venvs/atc/lib/python3.10/site-packages/nvidia/cuda_runtime/lib:%h/.venvs/atc/lib/python3.10/site-packages/nvidia/cublas/lib:%h/.venvs/atc/lib/python3.10/site-packages/nvidia/cufft/lib:%h/.venvs/atc/lib/python3.10/site-packages/nvidia/cudnn/lib:%h/.venvs/atc/lib/python3.10/site-packages/nvidia/curand/lib
ExecStart=%h/.venvs/atc/bin/python %h/atc_test/speech_gateway.py --host 0.0.0.0 --port 8099
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
