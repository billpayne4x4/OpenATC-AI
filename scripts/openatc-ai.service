[Unit]
Description=OpenATC AI services (LLM + STT + TTS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/Repository/Projects/openatc-ai/rust
ExecStart=/Repository/Projects/openatc-ai/rust/target/debug/openatc-ai --port 8099
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/bill/.config/openatc/ai-server.log
StandardError=inherit

[Install]
WantedBy=default.target
