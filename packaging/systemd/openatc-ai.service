[Unit]
Description=OpenATC AI services (LLM + STT + TTS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/openatc-ai
ExecStart=%h/.local/share/openatc-ai/bin/openatc-ai --port 8099
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
